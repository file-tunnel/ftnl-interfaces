{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://file-tunnel.dev/schema/v1/desktop-companion.schema.json",
  "title": "File Tunnel desktop companion parity record v1",
  "description": "Review evidence that every shared desktop contract change has been evaluated for both the Rust and Flutter implementations.",
  "type": "object",
  "properties": {
    "contract_version": {"const": 1},
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "changed_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["tunnel", "events", "proximity", "desktop_companion"]
      }
    },
    "implementations": {
      "type": "object",
      "properties": {
        "rust_desktop": {
          "$ref": "#/$defs/implementationImpact"
        },
        "flutter_desktop": {
          "$ref": "#/$defs/implementationImpact"
        }
      },
      "required": ["rust_desktop", "flutter_desktop"],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "change_id",
    "changed_contracts",
    "implementations"
  ],
  "additionalProperties": false,
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*/[A-Za-z0-9._-]+$",
      "maxLength": 200
    },
    "implementationImpact": {
      "oneOf": [
        {"$ref": "#/$defs/implementedImpact"},
        {"$ref": "#/$defs/notAffectedImpact"},
        {"$ref": "#/$defs/blockedImpact"}
      ]
    },
    "implementedImpact": {
      "type": "object",
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "status": {"const": "implemented"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "required": ["repository", "status", "evidence"],
      "additionalProperties": false
    },
    "notAffectedImpact": {
      "type": "object",
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "status": {"const": "not_affected"},
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "review_expires_on": {
          "type": "string",
          "format": "date"
        }
      },
      "required": ["repository", "status", "rationale", "review_expires_on"],
      "additionalProperties": false
    },
    "blockedImpact": {
      "type": "object",
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "status": {"const": "blocked"},
        "rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "follow_up_issue": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[0-9]+$",
          "maxLength": 512
        },
        "review_expires_on": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "repository",
        "status",
        "rationale",
        "follow_up_issue",
        "review_expires_on"
      ],
      "additionalProperties": false
    }
  }
}
